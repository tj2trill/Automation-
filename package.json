{
  "name": "@conway/automaton",
  "version": "0.2.1",
  "description": "Conway Automaton - Sovereign AI Agent Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "conway-automaton": "dist/index.js",
    "automaton-host": "./dist/host/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Conway-Research/automaton.git"
  },
  "homepage": "https://conway.tech",
  "keywords": [
    "autonomous-agent",
    "sovereign-ai",
    "web4",
    "conway",
    "self-replicating"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs && pnpm -r build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run --grep 'security|injection|policy'",
    "test:financial": "vitest run --grep 'financial|spend|treasury'",
    "test:ci": "vitest run --reporter=verbose",
    "clean": "rm -rf dist && pnpm -r clean",
    "host": "node dist/host/cli.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^11.0.0",
    "bs58": "^6.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "imapflow": "^2.11.0",
    "js-tiktoken": "^1.0.21",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "openai": "^6.24.0",
    "qrcode-terminal": "0.12.0",
    "siwe": "^2.3.0",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20.10.0",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1"
    }
  }
}
